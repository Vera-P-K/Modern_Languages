#include <stdio.h> // Подключает стандартную библиотеку для функций ввода-вывода (printf)

// Объявление макроса PR с параметрами fmt (формат вывода) и x (указатель).
// #x — преобразует имя аргумента в строку (например, "p1").
// %p — выводит адрес памяти в шестнадцатеричном виде.
// (void*)x — приводит указатель к универсальному типу для корректного вывода через %p.
// *x — разыменовывает указатель, чтобы получить само значение (число или символ).
// &x — выводит адрес самой переменной-указателя в памяти.
#define PR(fmt, x) printf(#x "=%p, *" #x "=" fmt ", &" #x "=%p\n", (void*)x, *x, (void*)&x)

int main(void) { // Точка входа в программу. Возвращает int (целое число) согласно стандарту.
    
    // --- 1. Работа с целыми числами (int) ---
    int mas[] = {100, 200, 300}; // Создает массив mas из трех целых чисел.
    int *p1 = mas;               // Указатель p1 получает адрес начала массива mas.
    PR("%d", p1);                // Вызывает макрос: выводит адрес p1, значение 100 и адрес переменной p1.

    // --- 2. Работа с числами с плавающей точкой (double) ---
    double d_mas[] = {10.5, 20.5, 30.5}; // Массив чисел двойной точности.
    double *p2 = d_mas;                  // Указатель p2 указывает на начало d_mas.
    PR("%.1f", p2);                      // Вызывает макрос: выводит адрес p2, значение 10.5 и адрес переменной p2.

    // --- 3. Работа с символами (char) ---
    char c_mas[] = {'A', 'B', 'C'}; // Массив из трех символов.
    char *p3 = c_mas;               // Указатель p3 указывает на символ 'A'.
    PR("%c", p3);                   // Вызывает макрос: выводит адрес p3, символ 'A' и адрес переменной p3.

    // --- Пример адресной арифметики ---
    int *ptr1 = mas;        // ptr1 указывает на первый элемент (mas[0] = 100).
    int *ptr2 = &mas[2];    // ptr2 указывает на третий элемент (mas[2] = 300).
    
    // Вычитание указателей одного типа дает разницу в количестве элементов, а не байт.
    // %td — спецификатор для типа ptrdiff_t (результат вычитания указателей).
    printf("\nptr2 - ptr1 = %td (элемента)\n", ptr2 - ptr1); 

    return 0; // Сообщает операционной системе, что программа завершилась успешно.
}
